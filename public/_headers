/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; font-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' https://huggingface.co https://*.hf.co https://*.huggingface.co; object-src 'none'; base-uri 'self'; form-action 'none';
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: microphone=(), camera=(), geolocation=(), payment=(), usb=(), serial=(), interest-cohort=()

/wasm/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=86400

/wasm/*.mjs
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: public, max-age=86400
